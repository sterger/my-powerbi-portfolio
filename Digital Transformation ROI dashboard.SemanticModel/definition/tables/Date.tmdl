	column WeekName = "Week" & [Week of Year]
		lineageTag: 30b159fb-f4a0-4c61-a5f0-4fbb2e507eff
		summarizeBy: none
		sortByColumn: 'Week of Year'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	partition Date = m
		mode: import
		source = ```
				let
				    // 1. Define the Start Date and dynamically calculate End Date (End of current year)
				    StartDate = #date(2025, 1, 1), 
				    EndDate = #date(2028, 12, 31),
				    
				    // 2. Generate a continuous list of numbers between Start and End dates
				    DayCount = Duration.Days(EndDate - StartDate) + 1,
				    DateList = List.Dates(StartDate, DayCount, #duration(1, 0, 0, 0)),
				
				    // 3. Convert the list into a structured table
				    TableFromList = Table.FromList(DateList, Splitter.SplitByNothing(), {"Date"}, null, ExtraValues.Error),
				    ChangedType = Table.TransformColumnTypes(TableFromList, {{"Date", type date}}),
				
				    // 4. Add standard date dimension columns
				    AddYear = Table.AddColumn(ChangedType, "Year", each Date.Year([Date]), Int64.Type),
				    AddQuarter = Table.AddColumn(AddYear, "Quarter", each "Q" & Text.From(Date.QuarterOfYear([Date])), type text),
				    AddMonthNum = Table.AddColumn(AddQuarter, "Month Number", each Date.Month([Date]), Int64.Type),
				    AddMonthName = Table.AddColumn(AddMonthNum, "Month Name", each Date.MonthName([Date]), type text),
				    AddShortMonth = Table.AddColumn(AddMonthName, "Short Month", each Text.Start([Month Name], 3), type text),
				    AddYearMonth = Table.AddColumn(AddShortMonth, "Year Month", each Text.From([Year]) & "-" & Text.PadStart(Text.From([Month Number]), 2, "0"), type text),
				    AddWeekNum = Table.AddColumn(AddYearMonth, "Week of Year", each Date.WeekOfYear([Date]), Int64.Type),
				    AddDayOfWeek = Table.AddColumn(AddWeekNum, "Day of Week", each Date.DayOfWeek([Date]), Int64.Type),
				    // Sort columns by chronological keys to fix visual sorting in Power BI
				    AddMonthSort = Table.AddColumn(AddDayOfWeek, "Year Month Sort", each [Year] * 100 + [Month Number], Int64.Type)
				in
				    AddMonthSort
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

